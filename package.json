{
  "name": "kv-radar",
  "version": "0.1.0",
  "private": true,
  "description": "KV-Radar — strukturierte Datenbank österreichischer Kollektivvertrags-Mindestgehälter",
  "scripts": {
    "dev": "next dev",
    "predev": "npm run data:validate",
    "build": "npm run data:validate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "data:validate": "tsx scripts/validate-data.ts",
    "data:report": "tsx scripts/build-report.ts",
    "data:freshness": "tsx scripts/freshness-report.ts",
    "data:deadlinks": "tsx scripts/deadlink-check.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "fuse.js": "^7.0.0",
    "next": "15.1.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.1.6",
    "js-yaml": "^4.1.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  },
  "engines": {
    "node": ">=20"
  }
}
